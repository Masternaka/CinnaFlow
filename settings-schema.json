{
    "layout": {
        "type": "combobox",
        "default": "two-columns",
        "description": "Disposition active",
        "tooltip": "La disposition appliquee par les raccourcis et le menu de panneau.",
        "options": {
            "Deux colonnes": "two-columns",
            "Colonne principale et pile": "main-stack",
            "Trois colonnes": "three-columns",
            "Grille 2 x 2": "grid"
        }
    },
    "gap": {
        "type": "spinbutton",
        "default": 12,
        "min": 0,
        "max": 64,
        "step": 1,
        "units": "px",
        "description": "Espacement entre les tuiles"
    },
    "outer-gap": {
        "type": "spinbutton",
        "default": 8,
        "min": 0,
        "max": 64,
        "step": 1,
        "units": "px",
        "description": "Marge autour de la disposition"
    },
    "show-indicator": {
        "type": "checkbox",
        "default": true,
        "description": "Afficher l'indicateur dans le panneau"
    },
    "tile-left": {
        "type": "keybinding",
        "default": "<Super><Alt>Left",
        "description": "Placer ou deplacer la fenetre vers la tuile de gauche"
    },
    "tile-right": {
        "type": "keybinding",
        "default": "<Super><Alt>Right",
        "description": "Placer ou deplacer la fenetre vers la tuile de droite"
    },
    "tile-up": {
        "type": "keybinding",
        "default": "<Super><Alt>Up",
        "description": "Placer ou deplacer la fenetre vers la tuile du haut"
    },
    "tile-down": {
        "type": "keybinding",
        "default": "<Super><Alt>Down",
        "description": "Placer ou deplacer la fenetre vers la tuile du bas"
    }
}
